// Devyatra relational model — permanent, database-driven temple directory.
//
// Hierarchy (spec §1–6):
//   Country (India) → State/UT → District → AdministrativeUnit
//   (Mandal / Taluk / Tehsil / Block / Circle… per state) → Locality → Temple
//
// Every location row carries optional official administrative codes and a
// source + lastVerifiedAt. Codes are only set by the official-data importer
// (LGD/Census); nothing is fabricated here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Country ────────────────────────────────────────────────────────────────

model Country {
  id           String  @id @default(cuid())
  code         String  @unique // "IN"
  iso3         String? // "IND"
  officialCode String? // LGD country code
  slug         String  @unique // "india"
  name         String
  nameLocal    String?
  states       State[]
}

// ─── State / Union territory ────────────────────────────────────────────────

model State {
  id                String  @id @default(cuid())
  officialCode      String? @unique // LGD state/UT code, e.g. "29" (Karnataka)
  code              String  @unique // ISO 3166, e.g. "KA"
  slug              String  @unique // "karnataka"
  name              String
  nameLocal         String?
  type              String  @default("state") // "state" | "union_territory"
  adminUnitTerm     String  @default("Tehsil") // Mandal / Taluk / Tehsil / Block / Circle…
  adminUnitTermPl   String? // plural form, e.g. "Taluks"
  capital           String?
  tagline           String?
  source            String? // provenance for the row (e.g. "lgd" | "curated")
  lastVerifiedAt    DateTime?
  countryId         String
  country           Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  districts         District[]
  adminUnits        AdminUnit[]
  localities        Locality[]
  temples           Temple[]

  @@index([countryId])
}

// ─── District ───────────────────────────────────────────────────────────────

model District {
  id             String  @id @default(cuid())
  officialCode   String? // LGD district code (4-digit)
  slug           String  // "mysuru"
  name           String
  nameLocal      String?
  latitude       Float?
  longitude      Float?
  source         String?
  lastVerifiedAt DateTime?
  stateId        String
  state          State   @relation(fields: [stateId], references: [id], onDelete: Cascade)
  adminUnits     AdminUnit[]
  localities     Locality[]
  temples        Temple[]

  @@unique([stateId, slug])
  @@unique([stateId, officialCode])
  @@index([stateId])
}

// ─── Administrative unit (mandal / taluk / tehsil / block / circle) ─────────

model AdminUnit {
  id             String    @id @default(cuid())
  officialCode   String? // LGD sub-district code
  slug           String    // "mysuru-taluk"
  name           String    // "Mysuru"
  officialName   String? // e.g. "Mysuru Taluk"
  nameLocal      String?
  type           String // denormalised term from state.adminUnitTerm at import
  latitude       Float?
  longitude      Float?
  source         String?
  lastVerifiedAt DateTime?
  stateId        String
  state          State     @relation(fields: [stateId], references: [id], onDelete: Cascade)
  districtId     String
  district       District  @relation(fields: [districtId], references: [id], onDelete: Cascade)
  parentId       String?
  parent         AdminUnit? @relation("AdminUnitHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       AdminUnit[] @relation("AdminUnitHierarchy")
  localities     Locality[]
  temples        Temple[]

  @@unique([districtId, slug])
  @@unique([districtId, officialCode])
  @@index([stateId])
  @@index([districtId])
  @@index([parentId])
}

// ─── Locality (village / town / city) ───────────────────────────────────────

model Locality {
  id             String    @id @default(cuid())
  officialCode   String? // LGD village/town code
  slug           String
  name           String
  nameLocal      String?
  kind           String    @default("town") // "village" | "town" | "city"
  latitude       Float?
  longitude      Float?
  source         String?
  lastVerifiedAt DateTime?
  stateId        String
  state          State     @relation(fields: [stateId], references: [id], onDelete: Cascade)
  districtId     String
  district       District  @relation(fields: [districtId], references: [id], onDelete: Cascade)
  adminUnitId    String?
  adminUnit      AdminUnit? @relation(fields: [adminUnitId], references: [id], onDelete: SetNull)
  temples        Temple[]

  @@unique([adminUnitId, slug])
  @@index([stateId])
  @@index([districtId])
  @@index([adminUnitId])
}

// ─── Temple ─────────────────────────────────────────────────────────────────

model Temple {
  id                     String    @id // legacy stable id, e.g. "t-venkateswara"
  identifier             String    @unique // "TEMPLE-IND-KA-MYS-000123"
  slug                   String    @unique
  name                   String
  nameLocal              String?
  alternativeNames       String[]  @default([])
  googlePlaceId          String?   @unique
  description            String?
  mainDeity              String?
  deities                String[]  @default([])
  templeType             String? // used in the blessed path; left null otherwise
  tradition              String[]  @default([]) // only with documented evidence
  architecture           String?
  architectureSource     String?
  historicalPeriod       String?
  establishedYear        String?
  badges                 String[]  @default([])
  images                 String[]  @default([])
  documentedHistory      String? // what records/documentation establish
  traditionalBeliefs     String? // separately kept beliefs
  religiousSignificance  String?
  culturalSignificance   String?

  // Location — hierarchy refs are DB-driven (spec §6), never hard-coded.
  stateCode              String
  latitude               Float
  longitude              Float
  address                String?
  state                  State     @relation(fields: [stateCode], references: [code])
  districtId             String
  district               District  @relation(fields: [districtId], references: [id])
  adminUnitId            String?
  adminUnit              AdminUnit? @relation(fields: [adminUnitId], references: [id])
  localityId             String?
  locality               Locality? @relation(fields: [localityId], references: [id])

  // Contact & booking (only official sources, spec §27)
  officialWebsite        String?
  officialPhone          String?
  officialEmail          String?
  googleMapsUrl          String?

  // Verification & provenance (spec §29)
  verificationStatus     String    @default("UNVERIFIED")
  source                 String?
  sourceType             String? // "official" | "government" | "trusted" | "community" | "google" | "unverified"
  sourceUrl              String?
  lastVerifiedAt         DateTime?
  publishedBy            String?
  publishedAt            DateTime?
  createdBy              String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Audit & Quality (spec §17-18)
  dataConfidence                 Int       @default(50)
  googlePlaceVerificationStatus  String    @default("PENDING_LOOKUP")
  isCentroidFallback             Boolean   @default(false)
  asiMonumentId                  String?

  // Enrichments & Relational Audit
  timings                TempleTiming[]
  darshans               DarshanOption[]
  sevas                  Seva[]
  festivals              Festival[]
  bookings               TempleBooking[]
  timeline               TimelineItem[]
  whyFamous              WhyFamous[]
  nearby                 NearbyPlace[]
  famousPlaces           TempleNearbyPlace[]
  savedBy                Saved[]
  translations           TempleTranslation[]
  sources                TempleSource[]
  auditResults           AuditResult[]
  media                  TempleMedia[]

  @@index([stateCode])
  @@index([districtId])
  @@index([adminUnitId])
  @@index([localityId])
  @@index([mainDeity])
  @@index([verificationStatus])
  @@index([dataConfidence])
  @@index([isCentroidFallback])
  @@index([latitude, longitude])
}

// ─── Temple enrichments ─────────────────────────────────────────────────────

model TempleTiming {
  id                 String    @id @default(cuid())
  templeId           String
  temple             Temple    @relation(fields: [templeId], references: [id], onDelete: Cascade)
  day                String    @default("daily") // "monday"…"sunday" | "daily" | "festival" | "special"
  label              String? // "Morning darshan"…
  openTime           String? // "06:00"
  closeTime          String?
  breakStart         String?
  breakEnd           String?
  note               String?
  source             String?
  lastVerifiedAt     DateTime?
  verificationStatus String    @default("UNVERIFIED")

  @@index([templeId])
}

model DarshanOption {
  id                 String  @id @default(cuid())
  templeId           String
  temple             Temple  @relation(fields: [templeId], references: [id], onDelete: Cascade)
  name               String // "General darshan", "Special darshan"…
  type               String  @default("general") // "general" | "special" | "timed" | "vip" | "other"
  timing             String?
  price              String? // display string, currency included
  durationMin        Int?
  bookingRequired    Boolean @default(false)
  bookingUrl         String?
  source             String?
  lastVerifiedAt     DateTime?
  verificationStatus String  @default("UNVERIFIED")

  @@index([templeId])
}

model Seva {
  id                 String  @id @default(cuid())
  templeId           String
  temple             Temple  @relation(fields: [templeId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  timing             String?
  price              String?
  bookingRequired    Boolean @default(false)
  bookingUrl         String?
  source             String?
  lastVerifiedAt     DateTime?
  verificationStatus String  @default("UNVERIFIED")

  @@index([templeId])
}

model Festival {
  id                 String  @id @default(cuid())
  templeId           String
  temple             Temple  @relation(fields: [templeId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  dateLabel          String? // "Maha Shivaratri", "Vaikasi Visakam"…
  month              Int?    // lunar month per the temple's own calendar
  day                Int?
  specialTiming      String?
  bookingInformation String?
  isRegional         Boolean @default(false)
  source             String?
  lastVerifiedAt     DateTime?
  verificationStatus String  @default("UNVERIFIED")

  @@index([templeId])
  @@index([month, day])
}

model TempleBooking {
  id                 String   @id @default(cuid())
  templeId           String
  temple             Temple   @relation(fields: [templeId], references: [id], onDelete: Cascade)
  bookingType        String   @default("darshan") // darshan | seva | pooja | accommodation | festival | other
  onlineAvailable    Boolean?
  offlineAvailable   Boolean?
  price              String?
  bookingUrl         String?
  counterLocation    String?
  counterTiming      String?
  idRequirements     String?
  advanceBooking     Boolean?
  festivalBooking    Boolean?
  source             String?
  lastVerifiedAt     DateTime?
  verificationStatus String   @default("UNVERIFIED")

  @@index([templeId])
}

model TimelineItem {
  id       String @id @default(cuid())
  templeId String
  temple   Temple @relation(fields: [templeId], references: [id], onDelete: Cascade)
  year     String?
  title    String
  body     String
}

model WhyFamous {
  id       String @id @default(cuid())
  templeId String
  temple   Temple @relation(fields: [templeId], references: [id], onDelete: Cascade)
  icon     String
  title    String
  body     String
}

model NearbyPlace {
  id             String  @id @default(cuid())
  templeId       String
  temple         Temple  @relation(fields: [templeId], references: [id], onDelete: Cascade)
  kind           String
  name           String
  distanceKm     Float
  recommendation String?
  priceHint      String?
  cuisine        String?
}

// ─── Normalized Nearby Attractions Architecture (Phase V2.2) ──────────────

model FamousPlace {
  id                 String    @id @default(cuid())
  name               String
  nativeName         String?
  slug               String    @unique
  category           String    // "HERITAGE" | "PILGRIMAGE" | "NATURE" | "CULTURE" | "LOCAL_EXPERIENCES"
  subcategory        String?
  description        String
  latitude           Float
  longitude          Float
  address            String?
  city               String?
  district           String?
  state              String?
  country            String    @default("India")
  sourceType         String?   // "official" | "asi" | "unesco" | "tourism" | "trusted"
  sourceUrl          String?
  sourceRecordId     String?
  googlePlaceId      String?
  verificationStatus String    @default("VERIFIED_SOURCE")
  verifiedAt         DateTime?
  lastCheckedAt      DateTime? @default(now())
  imageReference     String?
  officialUrl        String?

  templeLinks        TempleNearbyPlace[]

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([category])
  @@index([latitude, longitude])
  @@index([district])
  @@index([state])
  @@map("nearby_places")
}

model TempleNearbyPlace {
  id                    String      @id @default(cuid())
  templeId              String
  temple                Temple      @relation(fields: [templeId], references: [id], onDelete: Cascade)
  nearbyPlaceId         String
  nearbyPlace           FamousPlace @relation(fields: [nearbyPlaceId], references: [id], onDelete: Cascade)
  distanceKm            Float
  estimatedDriveMinutes Int?
  estimatedWalkMinutes  Int?
  relationshipType      String?     @default("NEARBY")
  priority              Int         @default(1)
  verifiedAt            DateTime?

  createdAt             DateTime    @default(now())

  @@unique([templeId, nearbyPlaceId])
  @@index([templeId])
  @@index([nearbyPlaceId])
  @@map("temple_nearby_places")
}

// ─── Import jobs & audit (spec §90–91) ─────────────────────────────────────

model ImportJob {
  id            String      @id @default(cuid())
  kind          String // "location:lgd" | "temple:seed" | "temple:google" | "temple:csv" …
  source        String // provenance, e.g. "lgd-2023" | "seed-registry" | "google-places"
  status        String      @default("queued") // queued | running | completed | failed | partial
  startedAt     DateTime?
  completedAt   DateTime?
  recordsFound  Int         @default(0)
  recordsAdded  Int         @default(0)
  recordsUpdated Int        @default(0)
  duplicates    Int         @default(0)
  errors        Int         @default(0)
  summary       Json?
  logs          ImportLog[]

  @@index([status])
}

model ImportLog {
  id        String    @id @default(cuid())
  jobId     String
  job       ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  level     String    @default("info") // info | warn | error
  message   String
  entity    String?
  createdAt DateTime  @default(now())

  @@index([jobId])
}

// ─── Accounts & community (existing, DB-backed) ─────────────────────────────

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  normalizedEmail String?   @unique
  role            String    @default("user")
  password        String
  preferences     String?   // JSON string of UserPreferences
  followedTemples String[]  @default([])
  created         String
  sessions        Session[]

  @@index([email])
  @@index([normalizedEmail])
}

model Session {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([token])
}

model Saved {
  id       String @id
  userId   String
  templeId String
  temple   Temple @relation(fields: [templeId], references: [id], onDelete: Cascade)
  savedAt  String

  @@unique([userId, templeId])
}

model Report {
  id       String @id
  templeId String?
  email    String?
  topic    String
  detail   String
  status   String @default("open") // open | confirmed | resolved | rejected
  created  String
}

// ─── Multilingual Vernacular Translations (spec §14) ───────────────────────

model TempleTranslation {
  id                 String    @id @default(cuid())
  templeId           String
  temple             Temple    @relation(fields: [templeId], references: [id], onDelete: Cascade)
  languageCode       String    // "te", "ta", "kn", "ml", "hi", "mr", "bn", "or", "gu", "pa", "sa"
  scriptCode         String    // "Telu", "Taml", "Knda", "Mlym", "Deva", "Beng", "Orya", "Gujr", "Guru"
  translatedName     String
  transliteratedName String?
  isCanonicalNative  Boolean   @default(false)
  source             String?
  verificationStatus String    @default("UNVERIFIED")

  @@unique([templeId, languageCode])
  @@index([templeId])
  @@index([languageCode])
}

// ─── Multi-Source Provenance (spec §16) ─────────────────────────────────────

model TempleSource {
  id                 String    @id @default(cuid())
  templeId           String
  temple             Temple    @relation(fields: [templeId], references: [id], onDelete: Cascade)
  sourceType         String    // "GOVERNMENT_ENDOWMENT" | "LOCAL_ADMINISTRATION" | "STATE_TOURISM" | "ASI_MONUMENT_REGISTRY" | "CULTURAL_REGISTRY"
  sourceName         String
  sourceUrl          String?
  officialRecordId   String?   // ASI monument ID, HRCE code
  retrievedAt        DateTime?
  lastVerifiedAt     DateTime?
  verificationMethod String?   // "API_INGEST" | "MANUAL_AUDIT" | "FIELD_SURVEY"
  verificationStatus String    @default("UNVERIFIED")
  notes              String?

  @@index([templeId])
  @@index([sourceType])
}

// ─── Row-Level Forensic Audit Trail (spec §12) ──────────────────────────────

model AuditResult {
  id                String    @id @default(cuid())
  templeId          String?
  temple            Temple?   @relation(fields: [templeId], references: [id], onDelete: SetNull)
  templeIdentifier  String?
  templeName        String?
  fieldChecked      String    // "Coordinates", "Darshan_Timings", "Official_Website", "Online_Booking_URL"
  existingValue     String?
  sourceFound       String?
  sourceUrl         String?
  sourceType        String?
  verified          Boolean   @default(false)
  problem           String?
  recommendedAction String?
  severity          String    @default("MEDIUM") // "CRITICAL", "HIGH", "MEDIUM", "LOW"
  status            String    @default("OPEN")   // "OPEN", "RESOLVED", "FLAGGED"
  createdAt         DateTime  @default(now())

  @@index([templeId])
  @@index([fieldChecked])
  @@index([severity])
}

// ─── Crowdsourced User Submissions with Verification Queue (spec §26) ───────

model UserSubmission {
  id                 String    @id @default(cuid())
  templeName         String
  templeNameLocal    String?
  stateName          String
  districtName       String
  adminUnitName      String?
  localityName       String?
  latitude           Float
  longitude          Float
  mainDeity          String?
  description        String?
  sourceProof        String?
  contributorEmail   String?
  contributorName    String?
  status             String    @default("SUBMITTED") // "SUBMITTED", "IN_REVIEW", "VERIFIED", "REJECTED"
  rejectionReason    String?
  submittedAt        DateTime  @default(now())
  reviewedAt         DateTime?
  reviewedBy         String?

  @@index([status])
  @@index([stateName, districtName])
}

// ─── Temple Media & Image Engine Architecture (spec §Issue A) ────────────────

model TempleMedia {
  id                  String    @id @default(cuid())
  templeId            String
  temple              Temple    @relation(fields: [templeId], references: [id], onDelete: Cascade)
  kind                String    @default("PRIMARY") // PRIMARY | GALLERY | ARCHITECTURE | FESTIVAL | ENTRANCE
  sourceType          String    @default("GOOGLE_PLACES") // GOOGLE_PLACES | OFFICIAL | GOVERNMENT | ASI | CC | PUBLIC_DOMAIN
  sourceName          String?
  sourceUrl           String?
  googlePlaceId       String?
  googleMapsUrl       String?
  publicUrl           String?
  altText             String?
  caption             String?
  authorName          String?
  authorUrl           String?
  authorAvatarUrl     String?
  licenseType         String?
  attributionRequired Boolean   @default(false)
  attributionHtml     String?
  isPrimary           Boolean   @default(false)
  isApproved          Boolean   @default(false)
  isFactual           Boolean   @default(true)
  verificationStatus  String    @default("PENDING") // PENDING | AUTO_APPROVED | VERIFIED | REJECTED | MANUAL_REVIEW
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  verifiedAt          DateTime?
  expiresAt           DateTime?

  @@index([templeId])
  @@index([isPrimary])
  @@index([isApproved])
  @@index([sourceType])
  @@index([googlePlaceId])
}

// ─── Phase 14 & 17: Permanent Database-Backed Journeys & Public Sharing ─────

model Journey {
  id                String          @id @default(cuid())
  userId            String
  title             String
  circuitId         String?
  templeSlugs       String[]        @default([])
  templeNames       String[]        @default([])
  startDate         String
  totalDays         Int             @default(1)
  travelMode        String          @default("car")
  budget            String          @default("moderate")
  itineraryBrief    Json?
  notes             String?
  familyMode        Boolean         @default(false)
  seniorMode        Boolean         @default(false)
  accessibilityMode Boolean         @default(false)
  costBreakdown     Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  sharedJourneys    SharedJourney[]

  @@index([userId])
}

model SharedJourney {
  id             String    @id @default(cuid())
  shareCode      String    @unique // 12-char secure unique share identifier
  journeyId      String
  journey        Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  userId         String
  authorName     String    @default("A Pilgrim")
  isPublic       Boolean   @default(true)
  allowCopy      Boolean   @default(true)
  viewsCount     Int       @default(0)
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?

  @@index([shareCode])
  @@index([userId])
}

// ─── Phase 13 & 41: My Yatra Journal & Mark as Visited ───────────────────────

model VisitedTemple {
  id             String    @id @default(cuid())
  userId         String
  templeId       String
  templeSlug     String
  templeName     String
  visitedAt      DateTime  @default(now())
  darshanType    String?   // "general" | "special" | "mangal_aarti"
  notes          String?
  rating         Int?      // 1-5 subjective pilgrimage satisfaction
  sevaPerformed  String?
  prasadamTaken  Boolean   @default(false)
  isPrivate      Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, templeId])
  @@index([userId])
  @@index([templeId])
}

model JournalEntry {
  id             String    @id @default(cuid())
  userId         String
  journeyId      String?
  templeId       String?
  title          String
  content        String
  entryDate      DateTime  @default(now())
  mood           String?   // "peaceful" | "transcendent" | "gratitude" | "reflective"
  photoUrls      String[]  @default([])
  isPrivate      Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([journeyId])
  @@index([templeId])
}

// ─── Phase V2.5: Canonical National Places Master Architecture ─────────────

model Place {
  id                    String    @id @default(cuid())
  slug                  String    @unique
  name                  String
  nativeName            String?
  alternateNames        String[]  @default([])
  category              String    // Primary category: SACRED | HERITAGE | CAVES | HILLS | WATERFALLS | LAKES | NATURE | BEACHES | WILDLIFE | PARKS | FAMILY | ADVENTURE | CULTURE | FOOD | SHOPPING
  categories            String[]  @default([]) // Multi-category support
  subcategory           String?
  description           String

  // Geolocation & Precision
  latitude              Float
  longitude             Float
  coordinatePrecision   String    @default("EXACT") // EXACT | APPROXIMATE | ESTIMATED | CENTROID | UNKNOWN
  elevationMeters       Float?
  address               String?
  city                  String?
  district              String
  state                 String
  country               String    @default("India")
  stateCode             String?

  // Lifecycle & Access
  status                String    @default("ACTIVE") // ACTIVE | SEASONAL | TEMPORARILY_CLOSED | PERMANENTLY_CLOSED | RESTRICTED_ACCESS
  timings               String?
  entryFee              String?
  bestTimeToVisit       String?
  recommendedDuration   String?
  facilities            String[]  @default([])
  accessibilityFeatures String[]  @default([])

  // Statutory & Institutional Designations
  asiProtected          Boolean   @default(false)
  asiMonumentId         String?
  unescoDesignated      Boolean   @default(false)
  unescoReference       String?
  ramsarSite            Boolean   @default(false)
  tigerReserve          Boolean   @default(false)
  nationalPark          Boolean   @default(false)
  wildlifeSanctuary     Boolean   @default(false)
  elephantReserve       Boolean   @default(false)
  biosphereReserve      Boolean   @default(false)
  communityReserve      Boolean   @default(false)
  marineProtectedArea   Boolean   @default(false)
  importantBirdArea     Boolean   @default(false)
  gsiProtected          Boolean   @default(false)
  gsiMonumentId         String?
  giProductTag          String?

  // Supplemental Place Classification (Missing Places Spec)
  placeKind             String?   @default("point_of_interest")
  subtypes              String[]  @default([])
  activities            String[]  @default([])
  designations          String[]  @default([])
  faith                 String?
  religiousTradition    String?
  accessType            String?   @default("PUBLIC")
  accessRestrictions    String?

  // Trust & Verification
  verificationStatus    String    @default("UNVERIFIED") // VERIFIED_OFFICIAL | VERIFIED_INSTITUTIONAL | VERIFIED_SECONDARY | COMMUNITY_REPORTED | NEEDS_REVIEW | UNVERIFIED | REJECTED
  provenanceTier        String    @default("CURATED_DB") // OFFICIAL_STATUTORY | INTERNATIONAL_INSTITUTIONAL | STATE_GOVERNMENT | LOCAL_AUTHORITY | REPUTABLE_SECONDARY | COMMUNITY_REPORTED | CURATED_DB
  sourceName            String?
  sourceType            String?
  sourceUrl             String?
  officialWebsite       String?
  verifiedAt            DateTime?
  lastCheckedAt         DateTime? @default(now())

  // Media
  image                 String?
  imageAlt              String?
  imageCreditName       String?
  imageCreditSource     String?
  imageLicense          String?
  isAiGeneratedImage    Boolean   @default(false)

  // Tags & Highlights
  highlights            String[]  @default([])
  tags                  String[]  @default([])
  culturalTags          String[]  @default([])
  audienceTags          String[]  @default([])

  // Relationships
  sources               PlaceSource[]
  media                 PlaceMedia[]
  categoryRelations     PlaceCategoryRelation[]
  fromRelations         PlaceRelationship[] @relation("FromPlace")
  toRelations           PlaceRelationship[] @relation("ToPlace")

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([category])
  @@index([state])
  @@index([district])
  @@index([latitude, longitude])
  @@index([verificationStatus])
  @@index([provenanceTier])
  @@index([coordinatePrecision])
  @@index([status])
  @@map("places")
}

model PlaceCategoryRelation {
  id         String   @id @default(cuid())
  placeId    String
  place      Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  category   String
  isPrimary  Boolean  @default(false)

  @@unique([placeId, category])
  @@index([category])
  @@map("place_category_relations")
}

model PlaceSource {
  id                 String    @id @default(cuid())
  placeId            String
  place              Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)
  sourceType         String    // TIER1_OFFICIAL | TIER2_UNESCO | TIER3_STATE_DEPT | TIER4_LOCAL_AUTHORITY | TIER5_INSTITUTION | TIER6_SECONDARY | TIER7_COMMUNITY
  sourceName         String
  sourceUrl          String?
  officialRecordId   String?
  retrievedAt        DateTime  @default(now())
  lastVerifiedAt     DateTime?
  verificationMethod String?
  verificationStatus String    @default("UNVERIFIED")
  notes              String?

  @@index([placeId])
  @@index([sourceType])
  @@map("place_sources")
}

model PlaceMedia {
  id                  String    @id @default(cuid())
  placeId             String
  place               Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)
  kind                String    @default("PRIMARY") // PRIMARY | GALLERY | PANORAMA | HISTORIC
  sourceType          String    @default("VERIFIED_PHOTO") // OFFICIAL | WIKIMEDIA | UNSPLASH | CC | AI_ILLUSTRATION
  sourceUrl           String?
  publicUrl           String
  altText             String?
  caption             String?
  authorName          String?
  licenseType         String?
  attributionRequired Boolean   @default(false)
  isAiGenerated       Boolean   @default(false)
  isApproved          Boolean   @default(true)
  verificationStatus  String    @default("VERIFIED")
  createdAt           DateTime  @default(now())

  @@index([placeId])
  @@map("place_media")
}

model PlaceRelationship {
  id               String   @id @default(cuid())
  fromPlaceId      String
  fromPlace        Place    @relation("FromPlace", fields: [fromPlaceId], references: [id], onDelete: Cascade)
  toPlaceId        String
  toPlace          Place    @relation("ToPlace", fields: [toPlaceId], references: [id], onDelete: Cascade)
  relationshipType String   // is_near | is_part_of | is_inside | suggested_circuit
  distanceKm       Float?
  metadata         Json?

  @@unique([fromPlaceId, toPlaceId, relationshipType])
  @@index([fromPlaceId])
  @@index([toPlaceId])
  @@map("place_relationships")
}